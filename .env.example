# ==========================================
# ToplistNA API - Environment Template
# ==========================================

APP_ENV=development
APP_PORT=3001
API_BASE_URL=http://localhost:3001

# MySQL Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bookingna
DB_USERNAME=root
DB_PASSWORD=

# JWT Secrets
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=30d
ADMIN_JWT_SECRET=your_admin_jwt_secret_key_here

# FireGo Internal API
FIREGO_API_URL=https://api.firego.vn/api
FIREGO_INTERNAL_SECRET=firego_toplistna_secret_2026

# AI Engine
GEMINI_API_KEY=
XKIRO_API_KEY=
XKIRO_BASE_URL=https://api.xkiro.com/v1
XKIRO_MODEL=deepseek/deepseek-chat-v3.1

# Payment Gateways (Optional)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_API_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3001/api/v1/payment/vnpay/return

MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_RETURN_URL=http://localhost:3001/api/v1/payment/momo/return
MOMO_NOTIFY_URL=http://localhost:3001/api/v1/payment/momo/ipn

ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_ENDPOINT=https://sb-openapi.zalopay.vn/v2/create
ZALOPAY_CALLBACK_URL=http://localhost:3001/api/v1/payment/zalopay/callback

SEPAY_ACCOUNT_NO=
SEPAY_ACCOUNT_NAME=
SEPAY_BANK_NAME=
SEPAY_BANK_ID=
SEPAY_API_KEY=
